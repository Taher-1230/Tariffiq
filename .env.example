# TariffIQ Server Configuration (Production / Development)
# Secrets MUST NOT be committed to version control.

# Required: Google Gemini API Key for server-side attribute extraction
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Required in production: MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/tariffiq

# Required in production: Minimum 16-character secret for signing session JWTs
JWT_SECRET=your_secure_jwt_secret_min_16_chars_here

# Network & CORS configuration
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional rate limiting overrides (requests per 15-minute window)
# AI_RATE_LIMIT=20
# AUTH_RATE_LIMIT=10
# CLASSIFICATION_RATE_LIMIT=60
